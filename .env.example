# =====================================================================
# Copy to .env and adjust. .env is git-ignored.
#
# Every secret below has a placeholder value that is safe for local
# development ONLY. Generate real values before any shared deployment:
#   openssl rand -hex 32
# =====================================================================

# ----------------------------------------------------- demo warehouse
POSTGRES_DB=ops
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me-warehouse
POSTGRES_PORT=5432

# ------------------------------------------------------ Cube semantic layer
# Shared secret used to sign the JWTs the Blazor backend sends to Cube.
CUBEJS_API_SECRET=change-me-cube-api-secret-at-least-32-chars
CUBEJS_DEV_MODE=true
CUBE_API_PORT=4000
# Postgres wire protocol port of Cube's SQL API — this is what Metabase
# connects to, so that Metabase also reads through the semantic layer.
CUBE_SQL_PORT=15432
CUBEJS_SQL_USER=metabase
CUBEJS_SQL_PASSWORD=change-me-cube-sql-password
# Security context handed to SQL API sessions by checkSqlAuth in cube.js.
# Cube refuses every query that arrives without a tenant, so this is not
# optional. Metabase logs in as one static user, so the whole Metabase
# path is this one tenant.
CUBEJS_SQL_TENANT_ID=demo
# Comma-separated list of sites Metabase may see. Empty means all sites.
CUBEJS_SQL_ALLOWED_SITES=

# ------------------------------------------------------------ Metabase
METABASE_PORT=3000
# Server-to-server API key, created in Metabase under
# Admin -> Settings -> Authentication -> API keys, or by
# infra/metabase/bootstrap.py.
METABASE_API_KEY=
# Admin -> Settings -> Embedding -> Static embedding. Must match the
# value Metabase shows, otherwise embed tokens are rejected.
METABASE_EMBEDDING_SECRET_KEY=
# Numeric id of the Metabase database entry that points at Cube's SQL API.
METABASE_CUBE_DATABASE_ID=

# ---------------------------------------------------------- NL planner
# The question box runs against a local Ollama. Nothing leaves the
# machine — neither the question nor the field catalogue built from your
# semantic model.
#
# Two ways to provide it:
#   docker compose --profile ollama up -d   container, reachable as "ollama"
#   ollama serve                            on the host; then set
#                                           OLLAMA_BASE_URL below
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# Pull once before the first question: ollama pull qwen2.5:14b-instruct
# Needs roughly 10 GB of RAM or VRAM. On a smaller machine try
# qwen2.5:7b-instruct and expect the repair round to trigger more often.
OLLAMA_MODEL=qwen2.5:14b-instruct
# Set to false to hide the question box. The query editor stays fully
# functional and can express everything the question box could produce.
PLANNER_ENABLED=true

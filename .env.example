# =====================================================================
# Copy to .env and adjust. .env is git-ignored.
#
# Every secret below has a placeholder value that is safe for local
# development ONLY. Generate real values before any shared deployment:
#   openssl rand -hex 32
# =====================================================================

# ----------------------------------------------------- demo warehouse
POSTGRES_DB=ops
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me-warehouse
POSTGRES_PORT=5432

# ------------------------------------------------------ Cube semantic layer
# Shared secret used to sign the JWTs the Blazor backend sends to Cube.
CUBEJS_API_SECRET=change-me-cube-api-secret-at-least-32-chars
CUBEJS_DEV_MODE=true
CUBE_API_PORT=4000
# Postgres wire protocol port of Cube's SQL API — this is what Metabase
# connects to, so that Metabase also reads through the semantic layer.
CUBE_SQL_PORT=15432
CUBEJS_SQL_USER=metabase
CUBEJS_SQL_PASSWORD=change-me-cube-sql-password

# ------------------------------------------------------------ Metabase
METABASE_PORT=3000
# Server-to-server API key, created in Metabase under
# Admin -> Settings -> Authentication -> API keys, or by
# infra/metabase/bootstrap.py.
METABASE_API_KEY=
# Admin -> Settings -> Embedding -> Static embedding. Must match the
# value Metabase shows, otherwise embed tokens are rejected.
METABASE_EMBEDDING_SECRET_KEY=
# Numeric id of the Metabase database entry that points at Cube's SQL API.
METABASE_CUBE_DATABASE_ID=

# ------------------------------------------- lokale KI (Ollama)
# The question box runs against a local model, so neither the semantic
# catalogue nor the user's question leaves the network.
#
# Optional: with PLANNER_ENABLED=false the app still works in full, only
# the natural-language box is hidden. The query editor can express
# everything the planner could produce.
PLANNER_ENABLED=false
OLLAMA_PORT=11434

# Must be an instruction-tuned model that honours a JSON schema. The 7B
# class is the smallest that picks reliably from a domain catalogue.
# Alternatives: llama3.1:8b, mistral-nemo:12b, qwen2.5:14b-instruct
# (better, needs roughly 10 GB of RAM or VRAM).
PLANNER_MODEL=qwen2.5:7b-instruct

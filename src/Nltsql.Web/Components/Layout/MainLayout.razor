@inherits LayoutComponentBase

<FluentDesignTheme StorageName="nltsql-theme" />

<FluentLayout>
    <FluentHeader>
        Datenabfrage
    </FluentHeader>

    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />

        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <span>Semantische Schicht: Cube &middot; Visualisierung: Metabase</span>
    </FluentFooter>
</FluentLayout>

@* Providers required by the dialog, toast and tooltip services. *@
<FluentDialogProvider />
<FluentToastProvider MaxToastCount="6" />
<FluentTooltipProvider />

@page "/"
@using NLTSQL.Ai
@using NLTSQL.Core.Charting
@using NLTSQL.QueryEngine.Sql
@using NLTSQL.Semantics
@using NLTSQL.Semantics.Validation
@using NLTSQL.Core.Serialization
@using Microsoft.EntityFrameworkCore
@using NLTSQL.Data
@using NLTSQL.Data.Entities
@using NLTSQL.Web.Charting
@inject AskService AskService
@inject DashboardStore Store
@inject AuthenticationStateProvider AuthState
@inject ISemanticModelRegistry Models
@inject ILogger<Ask> Logger
@rendermode InteractiveServer

<PageTitle>Fragen — NLTSQL</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">

    <FluentLabel Typo="Typography.PageTitle">Frag deine Daten</FluentLabel>

    @if (this.modelNames.Count == 0)
    {
        <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
            Es ist kein Datenmodell geladen. Pruefe den konfigurierten Pfad unter <code>Nltsql:Semantics:Directory</code>.
        </FluentMessageBar>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="12">
            <FluentTextField @bind-Value="this.question"
                             @onkeydown="this.OnKeyDown"
                             Placeholder="z. B. Umsatz pro Monat im letzten Jahr"
                             Label="Frage"
                             Disabled="@this.running"
                             Style="flex: 1;" />

            <FluentSelect TOption="string"
                          Items="@this.modelNames"
                          @bind-Value="this.selectedModel"
                          Label="Datenmodell"
                          Disabled="@this.running" />

            <FluentButton Appearance="Appearance.Accent"
                          OnClick="this.RunAsync"
                          Disabled="@(this.running || string.IsNullOrWhiteSpace(this.question))">
                Fragen
            </FluentButton>
        </FluentStack>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Wrap="true">
            @foreach (var example in Examples)
            {
                <FluentButton Appearance="Appearance.Outline" Disabled="@this.running" OnClick="@(() => this.UseExample(example))">
                    @example
                </FluentButton>
            }
        </FluentStack>

        @if (this.running)
        {
            <FluentProgressRing />
            <FluentLabel Typo="Typography.Body">Das Modell plant die Abfrage …</FluentLabel>
        }

        @if (this.result is not null)
        {
            @if (!this.result.Success)
            {
                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false" Title="Die Frage liess sich nicht beantworten">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                        @foreach (var issue in this.result.Issues.Where(i => i.Severity is IssueSeverity.Error))
                        {
                            <span>@issue.Message</span>
                        }
                        <span>Formuliere die Frage anders oder nutze die Begriffe aus dem Datenmodell.</span>
                    </FluentStack>
                </FluentMessageBar>
            }
            else
            {
                @if (this.result.Chart is { Kind: ChartKind.Kpi } kpi)
                {
                    <div class="kpi-card">
                        <FluentLabel Typo="Typography.Subject">@this.KpiLabel(kpi)</FluentLabel>
                        <div class="kpi-value">@this.KpiValue(kpi)</div>
                    </div>
                }

                <ResultChart Chart="@this.result.Chart" Result="@this.result.Result" />

                @if (this.result.Chart is { } chart && chart.Kind is not ChartKind.Kpi)
                {
                    <FluentLabel Typo="Typography.Body" Color="Color.Disabled">@chart.Reason</FluentLabel>
                }

                <ResultTable Result="@this.result.Result" />

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center">
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => this.saving = true)">
                        Auf Dashboard speichern
                    </FluentButton>
                    @if (this.runId is { } id)
                    {
                        <FluentAnchor Appearance="Appearance.Outline" Href="@($"/export/{id}.csv")" Target="_self">
                            Als CSV herunterladen
                        </FluentAnchor>
                    }
                </FluentStack>

                @if (this.saving)
                {
                    <div class="save-panel">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                            <FluentLabel Typo="Typography.Subject">Auf Dashboard speichern</FluentLabel>

                            <FluentTextField @bind-Value="this.tileTitle" Label="Titel der Kachel" Style="width: 100%;" />

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Bottom">
                                <FluentSelect TOption="Dashboard"
                                              Items="@this.dashboards"
                                              OptionText="@(d => d.Title)"
                                              OptionValue="@(d => d.Id.ToString())"
                                              @bind-SelectedOption="this.selectedDashboard"
                                              Label="Dashboard" />
                                <FluentTextField @bind-Value="this.newDashboardTitle" Label="oder neues anlegen" />
                            </FluentStack>

                            @* Live is the default because a dashboard whose tiles hold last month's
                               numbers is worse than no dashboard — it looks current. A snapshot is
                               for the case where a figure was quoted somewhere and has to keep
                               saying what it said. *@
                            <FluentRadioGroup @bind-Value="this.tileMode" Label="Aktualisierung">
                                <FluentRadio Value="@TileMode.Live">Bei jedem Öffnen neu berechnen</FluentRadio>
                                <FluentRadio Value="@TileMode.Snapshot">Dieses Ergebnis einfrieren</FluentRadio>
                            </FluentRadioGroup>

                            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                                <FluentButton Appearance="Appearance.Accent" OnClick="this.SaveTileAsync" Disabled="@this.savingBusy">
                                    Speichern
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => this.saving = false)">
                                    Abbrechen
                                </FluentButton>
                            </FluentStack>

                            @if (this.saveError is { Length: > 0 } saveError)
                            {
                                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@saveError</FluentMessageBar>
                            }
                        </FluentStack>
                    </div>
                }

                <FluentLabel Typo="Typography.Body" Color="Color.Disabled">
                    @this.result.Result!.RowCount.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) Zeile(n)
                    in @this.result.Result.Duration.TotalMilliseconds.ToString("N0", CultureInfo.GetCultureInfo("de-DE")) ms
                    · Modell @this.result.ModelName @($"v{this.result.ModelVersion}")
                    · @this.result.Attempts Planungsversuch(e)
                </FluentLabel>
            }

            @* The derivation is shown for every answer, not hidden behind a debug switch. A figure
               nobody can trace back to a definition is one people are right not to trust, and this
               is how a domain expert confirms that "Umsatz" meant the measure they think it means. *@
            <FluentAccordion Style="width: 100%;">
                <FluentAccordionItem Heading="So ist diese Antwort entstanden">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <div>
                            <FluentLabel Typo="Typography.Subject">Strukturierte Abfrage</FluentLabel>
                            <pre class="code-block">@this.SpecJson</pre>
                        </div>
                        @if (this.result.Sql is { Length: > 0 } sql)
                        {
                            <div>
                                <FluentLabel Typo="Typography.Subject">Erzeugtes SQL</FluentLabel>
                                <pre class="code-block">@sql</pre>
                                <FluentLabel Typo="Typography.Body" Color="Color.Disabled">
                                    Werte stehen als Parameter darin, nie im Text — deshalb sind hier Platzhalter zu sehen.
                                </FluentLabel>
                            </div>
                        }
                    </FluentStack>
                </FluentAccordionItem>
            </FluentAccordion>
        }
    }
</FluentStack>

@code {
    private static readonly string[] Examples =
    [
        "Umsatz pro Monat",
        "Umsatz nach Vertriebskanal",
        "Wie viele Auftraege sind offen?",
        "Durchschnittlicher Auftragswert je Quartal",
    ];

    private static readonly System.Text.Json.JsonSerializerOptions SpecJsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.SnakeCaseLower,
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    private List<string> modelNames = [];
    private string selectedModel = string.Empty;
    private string question = string.Empty;
    private bool running;
    private AskResult? result;

    private Guid? runId;
    private string? userId;
    private bool saving;
    private bool savingBusy;
    private string? saveError;
    private string tileTitle = string.Empty;
    private string newDashboardTitle = string.Empty;
    private List<Dashboard> dashboards = [];
    private Dashboard? selectedDashboard;
    private TileMode tileMode = TileMode.Live;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        this.modelNames = [.. Models.Names.Order(StringComparer.Ordinal)];
        this.selectedModel = this.modelNames.FirstOrDefault() ?? string.Empty;

        var state = await AuthState.GetAuthenticationStateAsync();
        this.userId = state.User.Identity?.Name;

        await this.LoadDashboardsAsync();
    }

    private async Task LoadDashboardsAsync()
    {
        this.dashboards = [.. await Store.ListDashboardsAsync()];
        this.selectedDashboard ??= this.dashboards.FirstOrDefault();
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !this.running)
        {
            await this.RunAsync();
        }
    }

    private void UseExample(string example) => this.question = example;

    private async Task RunAsync()
    {
        if (this.running || string.IsNullOrWhiteSpace(this.question))
        {
            return;
        }

        this.running = true;
        this.result = null;
        this.runId = null;
        this.saving = false;
        this.saveError = null;

        try
        {
            this.result = await AskService.AskAsync(this.question, this.selectedModel);
        }
        catch (InvalidOperationException exception)
        {
            // Configuration and model problems surface here — a missing data source, a row policy
            // with no value. They are the operator's problem, not the user's, so the page says so
            // plainly instead of showing a stack trace.
            Logger.LogError(exception, "Asking a question failed.");
            this.result = new AskResult(
                this.question,
                this.selectedModel,
                0,
                null,
                null,
                null,
                null,
                [ValidationIssue.Error("ask.failed", "konfiguration", exception.Message)],
                0);
        }
        finally
        {
            this.running = false;
        }

        await this.RecordRunAsync();
    }

    /// <summary>
    /// Records what happened, successful or not.
    /// </summary>
    /// <remarks>
    /// Failures are recorded too: a run of questions the platform could not answer is the most
    /// direct signal of what the semantic model is missing, and it is lost entirely if only
    /// successes are kept. The record's id doubles as the CSV export handle, so an exported file is
    /// always traceable to a question somebody actually asked.
    /// </remarks>
    private async Task RecordRunAsync()
    {
        if (this.result is null)
        {
            return;
        }

        try
        {
            var run = await Store.RecordRunAsync(new QueryRun
            {
                UserId = this.userId,
                ModelName = this.result.ModelName,
                Question = this.result.Question,
                QuerySpecJson = this.result.Spec is null ? null : NltsqlJson.Serialize(this.result.Spec),
                Sql = this.result.Sql,
                RowCount = this.result.Result?.RowCount,
                DurationMs = this.result.Result?.Duration.TotalMilliseconds ?? 0,
                Attempts = this.result.Attempts,
                Success = this.result.Success,
                Error = this.result.Issues.Count == 0
                    ? null
                    : string.Join(" ", this.result.Issues.Select(i => i.Message)),
            });

            this.runId = this.result.Success ? run.Id : null;
            this.tileTitle = this.result.Question;
        }
        catch (DbUpdateException exception)
        {
            // Audit is not worth losing an answer over: the user has their result on screen, and
            // the export link simply does not appear.
            Logger.LogError(exception, "Recording the query run failed.");
        }
    }

    private async Task SaveTileAsync()
    {
        if (this.result?.Spec is null || this.savingBusy)
        {
            return;
        }

        this.savingBusy = true;
        this.saveError = null;

        try
        {
            var target = this.newDashboardTitle is { Length: > 0 } title
                ? await Store.CreateDashboardAsync(title.Trim(), this.userId)
                : this.selectedDashboard;

            if (target is null)
            {
                this.saveError = "Waehle ein Dashboard aus oder gib einen Namen fuer ein neues an.";
                return;
            }

            var query = new SavedQuery
            {
                Title = string.IsNullOrWhiteSpace(this.tileTitle) ? this.result.Question : this.tileTitle.Trim(),
                Question = this.result.Question,
                ModelName = this.result.ModelName,
                ModelVersion = this.result.ModelVersion,
                QuerySpecJson = NltsqlJson.Serialize(this.result.Spec),
                ChartSpecJson = this.result.Chart is null ? null : NltsqlJson.Serialize(this.result.Chart),
                CreatedBy = this.userId,
            };

            var snapshot = this.tileMode is TileMode.Snapshot
                ? NltsqlJson.Serialize(TileSnapshot.From(this.result.Result!))
                : null;

            await Store.AddTileAsync(target.Id, query, this.tileMode, snapshot);

            this.newDashboardTitle = string.Empty;
            this.saving = false;
            await this.LoadDashboardsAsync();
        }
        catch (DbUpdateException exception)
        {
            Logger.LogError(exception, "Saving a dashboard tile failed.");
            this.saveError = "Die Kachel konnte nicht gespeichert werden.";
        }
        finally
        {
            this.savingBusy = false;
        }
    }

    private string SpecJson =>
        this.result?.Spec is null
            ? "(keine)"
            : System.Text.Json.JsonSerializer.Serialize(this.result.Spec, SpecJsonOptions);

    private string KpiLabel(ChartSpec chart) =>
        this.result?.Result?.Columns.FirstOrDefault(c => c.Alias == chart.ValueColumns[0])?.Label ?? string.Empty;

    private string KpiValue(ChartSpec chart)
    {
        var column = this.result!.Result!.Columns.First(c => c.Alias == chart.ValueColumns[0]);
        var index = this.result.Result.Columns.ToList().FindIndex(c => c.Alias == column.Alias);
        return ResultFormatter.Format(this.result.Result.Rows[0][index], column);
    }
}

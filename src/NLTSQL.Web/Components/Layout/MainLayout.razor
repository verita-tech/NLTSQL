@inherits LayoutComponentBase

@* FluentDesignTheme follows the operating system's light/dark setting. The chart palette has
   validated steps for both, and every chart reads them from CSS custom properties, so the two
   stay in step without any JavaScript deciding a theme. *@
<FluentDesignTheme StorageName="nltsql-theme" />

<FluentLayout>
    <FluentHeader>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
            <FluentIcon Value="@(new Icons.Regular.Size24.DatabaseSearch())" Color="Color.Fill" />
            <FluentLabel Typo="Typography.PaneHeader" Color="Color.Fill">NLTSQL</FluentLabel>
        </FluentStack>
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <FluentLabel Color="Color.Fill">@context.User.Identity?.Name</FluentLabel>
            </Authorized>
        </AuthorizeView>
    </FluentHeader>

    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <FluentLabel Typo="Typography.Body">
            Antworten entstehen aus dem semantischen Modell — die erzeugte Abfrage ist zu jeder Zahl einsehbar.
        </FluentLabel>
    </FluentFooter>
</FluentLayout>

<FluentToastProvider MaxToastCount="4" />
<FluentDialogProvider />
